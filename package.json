{
  "name": "blue-tree-mango",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/postbuild.cjs",
    "preview": "node scripts/serve.cjs",
    "test": "playwright test",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "description": "A React Native mango tree invoice app with a responsive Expo web demo.",
  "engines": {
    "node": ">=22.13.0"
  }
}
